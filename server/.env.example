# AutoFlow AI Studio — Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API key — if omitted, the server falls back to smart mock responses
OPENAI_API_KEY=sk-...

# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/autoflow
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/autoflow
MONGO_URI=mongodb://localhost:27017/autoflow

# JWT secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
